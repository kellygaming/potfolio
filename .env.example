# Chat IA (section « Pose-moi une question ») — https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optionnel : deepseek-chat (défaut) ou deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# Formulaire de contact — https://resend.com (clé API + adresse qui reçoit les demandes)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Expéditeur vérifié sur Resend (par défaut : onboarding@resend.dev, ne livre qu'à l'adresse du compte Resend)
CONTACT_FROM_EMAIL=
