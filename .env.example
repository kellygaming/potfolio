# Chat IA (section « Pose-moi une question ») — https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Optionnel : deepseek-chat (défaut) ou deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# Formulaire de contact — canal principal : Telegram (mêmes valeurs que kora-topup)
TELEGRAM_ALERT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Formulaire de contact — e-mail (optionnel) — https://resend.com (clé API + adresse qui reçoit les demandes)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Expéditeur sur le domaine vérifié dans Resend (ex. Portfolio Kelly <contact@mail.kellygaming.tech>).
# Repli automatique : onboarding@resend.dev, qui ne livre qu'à l'adresse du compte Resend.
CONTACT_FROM_EMAIL=
